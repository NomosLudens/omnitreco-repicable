{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnitreco",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "omnitreco.nomosludens.ia.br", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_ROOM",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom"]
    }
  ]
}
